{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "env:generate": "node scripts/generate-env.mjs",
    "postinstall": "npm run env:generate",
    "prestart": "npm run env:generate",
    "start": "ng serve",
    "prebuild": "npm run env:generate",
    "build": "ng build",
    "prewatch": "npm run env:generate",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run env:generate",
    "test": "ng test",
    "pree2e": "npm run env:generate",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/service-worker": "^20.3.0",
    "@lucide/angular": "^1.45.0",
    "chart.js": "^4.5.1",
    "leaflet": "^1.9.4",
    "ng2-charts": "^9.0.0",
    "ngx-image-cropper": "^9.1.7",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.4",
    "swiper": "^14.2.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.7",
    "@angular/cli": "^20.3.7",
    "@angular/compiler-cli": "^20.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jasmine": "~5.1.0",
    "@types/leaflet": "^1.9.22",
    "autoprefixer": "^10.5.4",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2"
  }
}
