# Config del frontend para desarrollo local.
# Copia este archivo a `.env` y ajusta lo que necesites.
# `.env` está ignorado por git; este ejemplo sí se versiona.

# API / WebSockets
API_URL=http://localhost:3000/api
SOCKET_URL=http://localhost:3000

# Rutas / mapas
OSRM_URL=https://router.project-osrm.org
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
MAP_CENTER_LAT=9.0422
MAP_CENTER_LNG=-69.7423
MAP_ZOOM=15
MAP_PICKER_ZOOM=14

# Formato regional
CURRENCY_CODE=USD
LOCALE=en-US

# Defaults de formularios
DEFAULT_CITY=Guanare
DEFAULT_STATE=Portuguesa
DEFAULT_ZIP_CODE=3301
DEFAULT_COUNTRY=Venezuela

# UI
PAGE_SIZE=10
DEFAULT_BANNER_PHONE=+123-456-789

# E2E (Playwright)
E2E_PORT=4200
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=admin123
E2E_DELIVERY_EMAIL=delivery@example.com
E2E_DELIVERY_PASSWORD=delivery123
E2E_WAREHOUSE_EMAIL=bodega@example.com
E2E_WAREHOUSE_PASSWORD=bodega123
