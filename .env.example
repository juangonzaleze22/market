# ============================================================
# Configuracion para DOCKER (copia este archivo a .env)
#
#   cp .env.example .env
#
# El backend tambien recibe todas estas variables via env_file.
# Para desarrollo local SIN Docker se sigue usando backend/.env.
#
# Los valores de abajo son seguros para PROBAR el stack completo
# en tu maquina. Para un VPS lee DEPLOY.md (seccion Produccion).
# ============================================================

# --- Aplicacion ---
# development: crea tablas solo, no exige proveedor de correo, logs de SQL.
# production:  validaciones estrictas; usar en el VPS.
NODE_ENV=development
# Puerto publico del servicio web en el modo docker-compose.yml (local/manual).
# En Dokploy (docker-compose.dokploy.yml) NO se usa: Traefik ocupa 80/443.
HTTP_PORT=80

# Dominio publico. Solo lo usa docker-compose.dokploy.yml (Traefik).
# Ej: APP_DOMAIN=tudominio.com  (sin https://)
APP_DOMAIN=

# true solo en el primer arranque. Luego poner false.
DB_SYNCHRONIZE=true

# true siembra categorias, productos y usuarios demo (admin@example.com/admin123).
# En produccion dejarlo en false.
RUN_SEED=true

# --- PostgreSQL (contenedor db y backend) ---
DB_USERNAME=postgres
DB_PASSWORD=cambia_esta_clave
DB_NAME=market_db

# --- JWT ---
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# --- URLs publicas ---
# Dominio con el que se abre la app. En local: http://localhost
# En el VPS: https://tudominio.com
FRONTEND_URL=http://localhost
# Vacio = imagenes con ruta relativa (/uploads/...). Recomendado.
PUBLIC_URL=

# --- Auth / correo ---
# En local con MAIL_LOG_ONLY=true no hace falta configurar proveedor.
AUTH_REQUIRE_EMAIL_VERIFICATION=true
AUTH_EXPOSE_VERIFICATION_TOKEN=false
AUTH_THROTTLE_DEV_MULTIPLIER=1

MAIL_FROM="Market <no-reply@market.local>"
MAIL_PROVIDER=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
RESEND_API_KEY=
MAIL_LOG_ONLY=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --- Detras de proxies (nginx/Caddy/Traefik) ---
# 1 = solo el nginx incluido. 2 = con un proxy delante del nginx
# (Caddy del host o Traefik de Dokploy).
TRUST_PROXY=1
