PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=tu_contraseña
DB_NAME=market_db

# JWT
JWT_SECRET=tu_jwt_secret_super_seguro_cambia_esto_en_produccion
JWT_EXPIRES_IN=7d

# Base de las URLs de imágenes subidas. Vacío = ruta relativa (/uploads/...),
# servida a través del proxy del frontend (funciona en local y por túnel).
PUBLIC_URL=

# URL del frontend (destino de los enlaces de verificación y reseteo)
FRONTEND_URL=http://localhost:4200

# Auth
AUTH_REQUIRE_EMAIL_VERIFICATION=true
# Solo desarrollo/test: incluye devVerificationToken en la respuesta de registro.
# El backend se niega a arrancar en producción con este flag activo.
AUTH_EXPOSE_VERIFICATION_TOKEN=true
# Multiplica los límites de rate-limit fuera de producción (tests/dev).
AUTH_THROTTLE_DEV_MULTIPLIER=1000

# Correo
# Proveedores por API HTTPS (puerto 443). Orden de autodetección:
#   Mailjet > Resend > SMTP > consola.
# MAIL_PROVIDER fuerza uno concreto: mailjet | resend | smtp | log.
# MAIL_FROM debe ser un remitente validado en el proveedor.
MAIL_FROM="Market <no-reply@market.local>"
# MAIL_PROVIDER=mailjet

# Mailjet (recomendado: 200 emails/día gratis, remitente validado sin dominio).
# Claves en https://app.mailjet.com/account/apikeys
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# Resend (100 emails/día gratis; requiere dominio verificado para no ser
# tu propio correo). En pruebas usa onboarding@resend.dev como MAIL_FROM.
RESEND_API_KEY=

# Correo local con MailDev (solo si Mailjet/Resend no están configurados).
#   SMTP: localhost:1025   UI: http://localhost:1080
# Si SMTP_HOST está vacío, los correos se imprimen en la consola del backend.
# MAIL_LOG_ONLY=true fuerza el modo consola aunque haya proveedor configurado
# (útil para tests/E2E y para no enviar correos reales en desarrollo).
MAIL_LOG_ONLY=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="Market <no-reply@market.local>"
